{
  "manifest_version": 3,
  "name": "Readflix",
  "short_name": "Readflix",
  "version": "1.0.0",
  "description": "Read books, PDFs, comics and manga in a calm, Netflix-style reader. Everything stays on your device.",
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_title": "Open Readflix",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "unlimitedStorage"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Open Readflix"
    }
  },
  "offline_enabled": true
}